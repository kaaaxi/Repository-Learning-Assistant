# Public configuration only. Copy to .env if you want to override defaults.
# The real API key goes in backend/data/secrets.json (gitignored),
# or in the system environment variable DEEPSEEK_API_KEY (which takes priority).
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Supported model names: deepseek-flash, deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# Optional: analysis cache TTL in seconds (default 86400; 0 = never expire)
# ANALYSIS_CACHE_TTL=86400

# Optional: allowed frontend origins, comma separated
# (defaults already include localhost/127.0.0.1 on ports 5173 and 4173)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
